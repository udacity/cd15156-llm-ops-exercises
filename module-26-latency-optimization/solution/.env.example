# === API Keys ===
OPENAI_API_KEY=sk-your-openai-api-key
# Leave OPENAI_BASE_URL blank for the stock OpenAI API. If your course
# workspace issues a Vocareum key (prefix `voc-`), set it to:
#   OPENAI_BASE_URL=https://openai.vocareum.com/v1
OPENAI_BASE_URL=

# === Chroma (Vector DB) ===
# Embedded persistent client — no Docker, no server. Override the path
# only if you want the on-disk store somewhere other than data/chroma.
# CHROMA_PATH=data/chroma

# === Tracing — REQ-067 (M09) ===
# "phoenix" (default) launches an in-process Phoenix UI at
# http://localhost:6006 with traces persisted under data/phoenix/.
# "none" disables tracing (useful for tests/CI). Override the Phoenix
# host/port/working dir below if needed.
TRACING_BACKEND=phoenix
# PHOENIX_EMBEDDED=true
# PHOENIX_HOST=0.0.0.0
# PHOENIX_PORT=6006
# PHOENIX_WORKING_DIR=data/phoenix
# PHOENIX_PROJECT_NAME=scikitdocs

# === Models ===
MODEL_COMPLEX=gpt-4o
MODEL_SIMPLE=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# === Application ===
CONFIDENCE_THRESHOLD=0.7
COST_LOG_PATH=data/cost_log.jsonl

# === Feature flags ===
# The semantic answer cache (Module 15) stays ON — it is the subject of
# Exercise 1's cold-versus-cached measurement.
# The LLM-judge output guard (Module 20) is OFF for this module: it adds
# a ~1.5s judge LLM call to EVERY request, cache hits included, which
# would inflate both the cold and cached totals and swamp the RAG
# pipeline the latency exercises profile. Turn it back on and re-run to
# watch that cost land on the blocking route — that is the Exercise 2 stretch.
ENABLE_SEMANTIC_CACHE=true
ENABLE_OUTPUT_GUARD=false
